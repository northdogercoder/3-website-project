<style>
  :root {
    color-scheme: light dark;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: system-ui, sans-serif;
    text-align: center;
  }
  h1 {
    margin: 0 0 0.25rem;
    font-size: clamp(2rem, 8vw, 3.5rem);
